        <mxCell id="lg" value="Legenda UML" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;hideEmptyLabels=0;borderWidth=1;strokeColor=#666;fillColor=#ffffff;fontColor=#333;html=1;rounded=1;arcSize=8;" vertex="1" parent="1">
