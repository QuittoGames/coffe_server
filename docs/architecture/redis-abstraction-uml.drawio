        <!-- ══════════════ N O T A S ══════════════ -->

        <mxCell id="n1" value="⚠ BUG: search() retorna String.valueOf(RedisFuture) — toString do future, nunca o valor real. Corrompe CacheService." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#333;align=left;verticalAlign=top;spacing=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="360" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="n1" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="n2" value="⚠ CacheService injeta Connection, mas NENHUM bean Connection existe (adapter não é @Component, não há @Bean) → NoSuchBeanDefinitionException no startup (WIP)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#333;align=left;verticalAlign=top;spacing=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="560" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="n2" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="n3" value="✅ Lazy: boot NÃO depende do Redis — clients baratos no construtor; conexões só no 1º uso (computeIfAbsent); DCL no rate limiter. ✅ @PreDestroy shutdown fecha connections + clients (evita leak Netty)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#333;align=left;verticalAlign=top;spacing=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="640" width="300" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="n4" value="⚠ Typos em contrato público: getAdpterConnector, getProvaiders, RedisClientInstace, RedisArryCodec, pacotes DatabaseProvaider / Chace / Ratelimt. Renomear quebraria imports (dívida para versão com migração)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#333;align=left;verticalAlign=top;spacing=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="740" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="n4" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="n5" value="⚠ RateLimit / PolicyProvider na camada errada: são contratos de negócio e deveriam viver em domain/interfaces/. PolicyProvider não pode (importa bucket4j); RateLimit pode." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#333;align=left;verticalAlign=top;spacing=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="580" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e33" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="n5" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="n6" value="⚠ Drift de config: h2 só define a instância rate-limit; prod define cache + rate-limit → CacheService (usa &quot;cache&quot;) quebra em dev/h2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#333;align=left;verticalAlign=top;spacing=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1880" y="600" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="n6" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell>

